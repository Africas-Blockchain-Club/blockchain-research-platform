# Copy this file to .env and fill in what you need. Every setting is optional:
# with an empty .env the platform runs with AI and payments switched off and
# produces data-only reports.

# ---------------------------------------------------------------- Branding
# A fork changes these values. Also change primaryColor in .streamlit/config.toml.
BRAND_NAME=Africa's Blockchain Club
BRAND_SHORT=ABC
APP_NAME=Blockchain Research Platform
BRAND_ACCENT=#0b57c9
BRAND_ACCENT_DARK=#5ea3ff
REPO_URL=https://github.com/Africas-Blockchain-Club/blockchain-research-platform

# ---------------------------------------------------------------- AI write-ups
# Off when AI_ENABLED=false or when no key is set. The data-only report is
# the off state, so the platform still works without a key.
AI_ENABLED=true
ANTHROPIC_API_KEY=
# Comma-separated; the first is the default in the dashboard.
AI_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-fable-5-1
# Used once if the chosen model declines a request.
AI_FALLBACK_MODEL=claude-opus-5-5
# true on a public deployment: AI write-ups then only run behind a payment.
AI_REQUIRES_PAYMENT=false
# low, medium, high, xhigh or max. Leave empty for a model that does not accept it.
AI_EFFORT=high

# ---------------------------------------------------------------- Data sources
# Optional: raises CoinGecko's rate limit. Free key at https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# Optional: derivatives data (open interest, liquidations)
COINGLASS_API_KEY=
# Rand figures use this rate only when the live rate cannot be fetched.
FALLBACK_USD_ZAR=18.0
# Chart screenshots need Playwright and a browser (playwright install firefox).
SCREENSHOTS_ENABLED=true

# ---------------------------------------------------------------- Storage
# Postgres URL, or empty for a SQLite file (local_dev.db) in DATA_DIR.
DATABASE_URL=
# Where reports, the SQLite file and the usage log are written. Empty means the
# project folder. On Fly.io this is the mounted volume (/data).
DATA_DIR=

# ---------------------------------------------------------------- Payments for AI write-ups
# Off by default. When on, an AI write-up is unlocked by a USDC payment.
# CHAIN_ID=84532 is the Base Sepolia testnet demo (test USDC, no real value).
# CHAIN_ID=8453 is Base mainnet: real USDC paid to REPORT_RECIPIENT_ADDRESS.
# The RPC URL and USDC contract are filled in from CHAIN_ID; set them only to override.
PAYMENTS_ENABLED=false
CHAIN_ID=84532
PAYMENT_RPC_URL=
USDC_CONTRACT_ADDRESS=
REPORT_RECIPIENT_ADDRESS=
REPORT_PRICE_USDC=2.00
# Defaults: 1 on testnet, 3 on mainnet
PAYMENT_MIN_CONFIRMATIONS=
# Payments older than this cannot unlock a report
PAYMENT_MAX_AGE_MINUTES=60
# Optional fallbacks for payment verification when the RPC is unreachable
ETHERSCAN_API_KEY=
BLOCKSCOUT_API_KEY=

# ---------------------------------------------------------------- Email
# Emails the report and receipt to a payer. Leave any of these empty to switch email off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TEST_EMAIL_RECIPIENT=

# ---------------------------------------------------------------- x402 demo (x402/, local testnet only)
# Empty uses the public anvil test account. Never put a real private key here.
X402_PRIVATE_KEY=
X402_PAYWALL_URL=http://localhost:5402
X402_RPC_URL=http://localhost:8545
